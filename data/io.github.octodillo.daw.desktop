[Desktop Entry]
Type=Application
Name=Kadence
GenericName=Digital Audio Workstation
Comment=Record, arrange and mix music
# No %F or MimeType= until Kadence can open a project given on the command line.
Exec=kadence
Icon=io.github.octodillo.daw
Terminal=false
Categories=AudioVideo;Audio;Midi;Mixer;Sequencer;Recorder;Qt;KDE;
Keywords=music;audio;midi;daw;recording;mixing;sequencer;plugin;clap;lv2;vst3;
StartupNotify=true
StartupWMClass=kadence
