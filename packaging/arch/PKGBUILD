# SPDX-License-Identifier: GPL-3.0-or-later
# Maintainer: Octodillo <https://github.com/Octodillo>
#
# Development package built from git. `KADENCE_SOURCE` overrides where the
# source comes from, so CI can build the checkout it is testing:
#   KADENCE_SOURCE="git+file://$PWD#commit=$(git rev-parse HEAD)" makepkg
#
# The release package (kadence) is this file with the "kadence-git only"
# part below swapped for the release tarball: ./release-pkgbuild.sh writes
# it, so everything outside that part is shared by both.

pkgname=kadence-git
_appid=io.github.octodillo.daw
pkgver=0.1.0
pkgrel=1
pkgdesc='Digital audio workstation for KDE Plasma'
arch=(x86_64 aarch64)
url='https://github.com/Octodillo/Kadence'
# Kadence, plus the crates statically linked into it (symphonia is MPL-2.0).
# Their notices are in THIRD-PARTY-LICENSES next to LICENSE. CI fails when
# this stops covering them (packaging/check-license-fields.py).
license=(GPL-3.0-or-later MPL-2.0 Apache-2.0 MIT ISC Zlib)
depends=(
  glibc
  hicolor-icon-theme
  kcolorscheme
  kconfig
  kcoreaddons
  kcrash
  ki18n
  kiconthemes
  kirigami
  qqc2-desktop-style
  qt6-base
  qt6-declarative
  # libjack is loaded at run time; PipeWire's is the usual one on Plasma.
  jack
  # LV2 plugin hosting.
  lilv
)
makedepends=(
  cargo
  clang
  cmake
  extra-cmake-modules
  lld
  ninja
  python
)
optdepends=(
  'breeze-icons: icons outside Plasma'
)
options=(!lto !debug)

# >>> kadence-git only
makedepends+=(git)
provides=(kadence)
conflicts=(kadence)
_srcdir=kadence
source=("$_srcdir::${KADENCE_SOURCE:-git+$url.git}")
sha256sums=(SKIP)

pkgver() {
  cd "$_srcdir"
  local version
  version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_srcdir"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}
# <<< kadence-git only

build() {
  export RUSTUP_TOOLCHAIN=stable
  # prepare() fetched the crates, or the release tarball vendors them.
  export CARGO_NET_OFFLINE=true
  cmake -S "$_srcdir" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DKADENCE_LICENSE_DIR="share/licenses/$pkgname"
  cmake --build build
}

check() {
  local config
  config=$(mktemp -d)
  XDG_CONFIG_HOME="$config" QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software \
    build/cargo/release/kadence --smoke-test
  rm -rf "$config"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
